<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Runwick.AspNetCore\Runwick.AspNetCore.csproj" />
    <ProjectReference Include="..\Runwick.Harness\Runwick.Harness.csproj" />
    <!-- Build order only: peer tests start this process from its own output folder. -->
    <ProjectReference Include="..\Runwick.Harness.Peer\Runwick.Harness.Peer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\samples\Runwick.Samples.Contracts\Runwick.Samples.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <!-- The management host of the AspNetCore tests, run here over every store (MGMT cases, 16 §8). -->
    <Compile Include="..\Runwick.AspNetCore.Tests\MgmtHost.cs" Link="Management\MgmtHost.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
