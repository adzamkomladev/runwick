<Project Sdk="Microsoft.NET.Sdk">
  <!-- SP-023 spike: a mount-scoped Inertia v3 transport for the dashboard. Not shipped; SP-024 builds Runwick.Dashboard from it. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- ASP.NET Core-only code: no SynchronizationContext to avoid. -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Prebuilt by `npm run build` in ClientApp and committed; consumers need no Node. -->
    <EmbeddedResource Include="dist/**" LogicalName="runwick-dashboard/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Remove="ClientApp/**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Runwick.Dashboard.Spike.Tests" />
  </ItemGroup>
</Project>
