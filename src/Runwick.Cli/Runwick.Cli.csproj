<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>runwick: the command-line tool for operators, CI scripts and AI agents (talks to a Runwick management host over HTTP).</Description>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>runwick</ToolCommandName>
    <RootNamespace>Runwick.Cli</RootNamespace>
    <!-- A console tool: no synchronization context, and console writes are synchronous by nature. -->
    <NoWarn>$(NoWarn);CA2007;CA1849</NoWarn>
  </PropertyGroup>
  <!-- Self-contained single-file binaries for the certified hosts only (19 §1): dotnet publish -r linux-x64|win-x64. Not trimmed, no AOT. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runwick\Runwick.csproj" />
    <ProjectReference Include="..\Runwick.Postgres\Runwick.Postgres.csproj" />
    <ProjectReference Include="..\Runwick.Sqlite\Runwick.Sqlite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Runwick.Cli.Tests" />
  </ItemGroup>
</Project>
