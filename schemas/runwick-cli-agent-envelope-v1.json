{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "command": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "result": true,
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "hint": {
          "type": "string"
        },
        "actualRevision": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "hint",
        "actualRevision"
      ]
    },
    "commandId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "revisions": {
      "type": "object"
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "argv",
          "reason"
        ]
      }
    },
    "cli": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "context": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "version",
        "context",
        "url"
      ]
    },
    "stream": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "result",
    "error",
    "commandId",
    "revisions",
    "nextActions",
    "cli"
  ]
}
