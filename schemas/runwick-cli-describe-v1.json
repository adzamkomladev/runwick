{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "apiVersion": {
      "type": "string"
    },
    "envelopeSchema": true,
    "exitCodes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "errorCodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "hint": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "retryable",
          "hint"
        ]
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "mutation": {
            "type": "boolean"
          },
          "streaming": {
            "type": "boolean"
          },
          "permission": {
            "type": [
              "string",
              "null"
            ]
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type",
                "description"
              ]
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "requiredInAgentMode": {
                  "type": "boolean"
                },
                "allowed": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "default": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type",
                "required",
                "requiredInAgentMode",
                "allowed",
                "default",
                "description"
              ]
            }
          },
          "resultSchema": true
        },
        "required": [
          "name",
          "summary",
          "mutation",
          "streaming",
          "permission",
          "arguments",
          "options",
          "resultSchema"
        ]
      }
    }
  },
  "required": [
    "name",
    "version",
    "apiVersion",
    "envelopeSchema",
    "exitCodes",
    "errorCodes",
    "commands"
  ]
}
