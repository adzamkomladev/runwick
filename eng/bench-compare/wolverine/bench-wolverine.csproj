<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WolverineFx" Version="6.65.1" />
    <PackageReference Include="WolverineFx.Postgresql" Version="6.65.1" />
    <PackageReference Include="WolverineFx.Redis" Version="6.65.1" />
    <PackageReference Include="WolverineFx.Sqlite" Version="6.65.1" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.65.1" />
  </ItemGroup>
</Project>
