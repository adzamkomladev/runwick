<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>RunwickDocs</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SpaRoot>ClientApp\</SpaRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Inertia.Net" Version="1.7.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="node_modules\**;ClientApp\**;ssr\**;package*.json;tsconfig*.json;vite.config.ts;code-themes.ts;scripts\**" />
    <None Remove="node_modules\**;ClientApp\**;ssr\**;app.html" />
    <Content Include="app.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="content\docs\**\*.mdx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot\build\.vite\manifest.json" Condition="Exists('wwwroot\build\.vite\manifest.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ssr\**\*.js" Condition="Exists('ssr')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="wwwroot\hot" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
