<Project>
  <!-- Central package management. Pins checked against nuget.org on 2026-10-30; see eng/package-graph.json. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="NodaTime" Version="3.3.7" />
    <!-- SP-022 Runwick.OpenTelemetry: latest stable on 2026-11-08 that is at least two weeks old (published 2026-10-20). -->
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup Label="Hosts, tests and tools">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!-- Matches the Microsoft.AspNetCore.App shared framework the SDK runs (10.0.14). -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <!-- Test-only JSON Schema validator for the CLI agent envelope (SP-032, 19 §9). -->
    <PackageVersion Include="JsonSchema.Net" Version="9.2.2" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <!-- SP-018 prototype tests; D-09 client baseline, also the future Runwick.Redis pin. -->
    <PackageVersion Include="StackExchange.Redis" Version="3.4.20" />
    <!-- SP-023 dashboard: the Inertia adapter (named mounts since 1.7.0). -->
    <PackageVersion Include="Inertia.Net" Version="1.7.0" />
    <!-- SP-022 telemetry tests (test projects only); same release as the OpenTelemetry pin. -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
  </ItemGroup>
</Project>
