<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- SP-023: a host app that already uses Inertia.Net for its own pages and mounts the dashboard spike. Drives the browser runs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Runwick.Dashboard.Spike\Runwick.Dashboard.Spike.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Inertia.Net" />
  </ItemGroup>
  <ItemGroup>
    <None Update="app.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
